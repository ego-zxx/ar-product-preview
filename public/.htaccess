# --- AR Preview on cPanel / Apache ---

# WebXR and the camera require a secure context. Without this the AR button
# simply will not appear.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Apache does not know these by default; a wrong Content-Type makes the loader
# reject the model.
AddType model/gltf-binary   .glb
AddType model/gltf+json     .gltf
AddType application/wasm    .wasm

# Single-page app: send unknown paths to index.html so /admin resolves.
# Real files and the API are left alone.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/models/
RewriteRule . index.html [L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # hashed filenames, safe to cache hard
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "\.(glb|gltf)$">
    ExpiresDefault "access plus 7 days"
  </FilesMatch>
  # never cache the entry point, or a deploy will not take
  <FilesMatch "index\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
